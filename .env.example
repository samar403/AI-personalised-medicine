# Required in production: a long random string (openssl rand -base64 32)
AUTH_SECRET=

# Required in production: encrypts genotype data at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32. Changing it makes stored genomes unreadable.
DATA_ENCRYPTION_KEY=

# Claude powers the care plan narrative, medication explanations, clinician briefs and the assistant.
# Leave empty to run in offline mode with the built-in rules engine.
# Claude is only called for a vault whose owner has turned on "AI analysis" in Privacy & sharing.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# SQLite file locally; use a libsql:// URL + token for Turso in production
DATABASE_URL=file:./data/allele.db
# DATABASE_AUTH_TOKEN=

# Set to false to skip the demo vault on first setup
# SEED_DEMO=false
